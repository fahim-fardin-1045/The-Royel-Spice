# Copy to .env and fill in your local XAMPP MySQL password.
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_USE_PYTHON_SECRETS
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3307/royal_spice?charset=utf8mb4
# For XAMPP root with a BLANK password, use:
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3307/royal_spice?charset=utf8mb4
APP_ENV=development
COOKIE_SECURE=0
